{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framegraph.dev/symbols/covers/cover_minimal_sidebar.schema.json",
  "title": "cover_minimal_sidebar — instance contract",
  "description": "Validation schema for a single instance of the cover_minimal_sidebar template. Used by the deck author to populate a 'use' object referencing symbol 'cover_minimal_sidebar'.",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "symbol", "box", "title"],
  "properties": {
    "type": {
      "const": "use",
      "description": "Must be the literal 'use' — this is the FrameGraph object type that instantiates a symbol."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9._]*$"
    },
    "symbol": {
      "const": "cover_minimal_sidebar"
    },
    "box": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "description": "[x, y, w, h] of the instance on the slide. Use [0, 0, 960, 540] for a full-canvas cover."
    },

    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Primary headline rendered in the title block."
    },
    "subtitle": {
      "type": "string",
      "maxLength": 140,
      "description": "One-line tagline rendered immediately under the title. Optional — pass an empty string to suppress."
    },
    "page_number": {
      "type": "string",
      "maxLength": 4,
      "description": "Footer numeral (e.g. '1' or '01'). Optional — pass an empty string to suppress."
    },

    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg_color": {
          "$ref": "#/$defs/color",
          "default": "#FFFFFF",
          "description": "Slide-field fill color."
        },
        "title_color": {
          "$ref": "#/$defs/color",
          "default": "#1A2B3E",
          "description": "Title text color. Conventionally matches right_block_color."
        },
        "subtitle_color": {
          "$ref": "#/$defs/color",
          "default": "#8A8A8A",
          "description": "Subtitle text color (neutral gray)."
        },
        "accent_color": {
          "$ref": "#/$defs/color",
          "default": "#E51A4C",
          "description": "Vertical accent stripe color near the right edge."
        },
        "right_pane_color": {
          "$ref": "#/$defs/color",
          "default": "#1A2B3E",
          "description": "Wide right-edge pane fill. 212 px on a 960 px canvas — mirror of agenda_left_pane's left_pane_color."
        },
        "page_number_color": {
          "$ref": "#/$defs/color",
          "default": "#8A8A8A",
          "description": "Footer page-number color."
        }
      }
    }
  },

  "$defs": {
    "color": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
          "description": "Hex color literal."
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Named color token resolved from deck.tokens.colors."
        }
      ]
    }
  },

  "examples": [
    {
      "type": "use",
      "id": "v.cover",
      "symbol": "cover_minimal_sidebar",
      "box": [0, 0, 960, 540],
      "title": "Docusign Workshop 1.1",
      "subtitle": "Organizational Structure and Key Concepts",
      "page_number": "1",
      "params": {
        "bg_color": "#FFFFFF",
        "title_color": "#1A2B3E",
        "subtitle_color": "#8A8A8A",
        "accent_color": "#E51A4C",
        "right_pane_color": "#1A2B3E",
        "page_number_color": "#8A8A8A"
      }
    }
  ]
}
