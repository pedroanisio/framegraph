(* ═══════════════════════════════════════════════════════════════════ *)
(* FrameGraph — grammar (EBNF)                                          *)
(*                                                                      *)
(* GENERATED, NON-NORMATIVE. Do not edit by hand.                       *)
(*   Source of truth : framegraph._schema (Pydantic v2 models) +        *)
(*                      framegraph._frameset.FrameSetDocument           *)
(*   Generator       : scripts/generate_ebnf.py                         *)
(*   framegraph      : v0.1.0                                         *)
(*                                                                      *)
(* The Pydantic model graph is the executable, normative contract; this *)
(* EBNF is derived from the JSON Schema those models emit, so it cannot *)
(* drift. Regenerate with: python scripts/generate_ebnf.py             *)
(*                                                                      *)
(* Scope: a structural grammar over the YAML/JSON DATA MODEL (a YAML    *)
(* document is a superset of JSON). Terminals `string`/`number`/... are *)
(* YAML scalars; the `"{"`/`"["` terminals are shown in JSON flow style *)
(* — the equivalent YAML block form is always valid. Mapping members    *)
(* are UNORDERED; the commas/braces are the JSON projection only.       *)
(* Models declared `extra="allow"` admit arbitrary extra keys, shown as *)
(* a trailing `{ extra-member }`.                                        *)
(*                                                                      *)
(* Dialect: ISO/IEC 14977.  = define  ; end  , concat  | or            *)
(*   [ ] optional   { } repeat(0+)   ( ) group   "x" terminal           *)
(*   ? x ? lexical token   ;   paren-star ... star-paren = comment       *)
(* ═══════════════════════════════════════════════════════════════════ *)


(* ── Start symbol ── *)

framegraph-document = Document | DeckDocument | FrameSetDocument ;

(* ── Document roots ── *)

Document =
    "{" ,
      "dsl" , ":" , "FrameGraph" ,
      "version" , ":" , number ,
      [ "kind" , ":" , string ] ,
      "scene" , ":" , Scene ,
      [ "semantic" , ":" , Semantic ] ,
      [ "visual" , ":" , Visual ] ,
      { extra-member } ,
    "}" ;

DeckDocument =
    "{" ,
      "dsl" , ":" , "FrameGraph" ,
      "version" , ":" , number ,
      [ "kind" , ":" , string ] ,
      [ "deck" , ":" , DeckConfig ] ,
      [ "slides" , ":" , "[" , [ SlideEntry , { "," , SlideEntry } ] , "]" ] ,
      [ "$theme" , ":" , string ] ,
      { extra-member } ,
    "}" ;

FrameSetDocument =
    "{" ,
      "dsl" , ":" , "FrameGraph" ,
      "version" , ":" , number ,
      "kind" , ":" , "frameset" ,
      [ "frameset" , ":" , FrameSetMeta ] ,
      [ "$theme" , ":" , string ] ,
      [ "stylesheet" , ":" , string ] ,
      "frames" , ":" , "[" , Frame , { "," , Frame } , "]" ,
    "}" ;

(* ── Visual object (discriminated on `type`) ── *)

VisualObject =
      BarChartObject
    | BulletListObject
    | ChipRowObject
    | ComponentObject
    | ConnectorObject
    | ContainerObject
    | EllipseObject
    | GroupObject
    | IconObject
    | ImageObject
    | LegendObject
    | LineObject
    | LineChartObject
    | PathObject
    | PolylineObject
    | RectObject
    | TableObject
    | TextObject
    | UMLActionObject
    | UMLActivationBarObject
    | UMLActivityNodeObject
    | UMLActorObject
    | UMLArtifactBoxObject
    | UMLClassifierBoxObject
    | UMLComponentBoxObject
    | UMLFragmentFrameObject
    | UMLLifelineObject
    | UMLLollipopObject
    | UMLMarkerGlyphObject
    | UMLNodeBoxObject
    | UMLPseudostateObject
    | UMLSocketObject
    | UMLStateBoxObject
    | UMLSwimlaneObject
    | UMLTimingLaneObject
    | UseObject
    | _UnknownObject
    ;

common-object-fields = (* every field optional; mapping members unordered *)
      [ "id" , ":" , string ] ,
      [ "decorative" , ":" , boolean ] ,
      [ "bind" , ":" , string ] ,
      [ "box" , ":" , "[" , number , "," , number , "," , number , "," , number , "]" ] ,
      [ "rotation" , ":" , any ] ,
      [ "ports" , ":" , "{" , { string , ":" , "[" , number , "," , number , "]" } , "}" ] ,
      [ "opacity" , ":" , number ] ,
      [ "fill_opacity" , ":" , number ] ,
      [ "stroke_opacity" , ":" , number ] ,
      [ "shadow" , ":" , ( string | object-any | boolean ) ] ,
      [ "glow" , ":" , ( string | object-any | boolean ) ] ,
      [ "outer_ring" , ":" , ( OuterRing | object-any ) ]
    ;

