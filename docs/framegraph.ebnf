      [ "rendering_contract" , ":" , RenderingContract ] ,
      [ "source_image" , ":" , object-any ] ,
      { extra-member } ,
    "}" ;

Semantic =
    "{" ,
      [ "ontology" , ":" , Ontology ] ,
      [ "nodes" , ":" , "[" , [ NodeEntry , { "," , NodeEntry } ] , "]" ] ,
      [ "edges" , ":" , "[" , [ EdgeEntry , { "," , EdgeEntry } ] , "]" ] ,
      { extra-member } ,
    "}" ;

SemanticsContract =
    "{" ,
      [ "decorative_objects_may_omit_bind" , ":" , boolean ] ,
      { extra-member } ,
    "}" ;

SlideEntry =
    "{" ,
      [ "slide" , ":" , integer ] ,
      "id" , ":" , string ,
      [ "title" , ":" , string ] ,
      [ "description" , ":" , string ] ,
      [ "notes" , ":" , string ] ,
      [ "$extends" , ":" , string ] ,
      [ "tokens" , ":" , Tokens ] ,
      [ "symbols" , ":" , "{" , { string , ":" , SymbolDef } , "}" ] ,
      [ "semantic" , ":" , Semantic ] ,
      [ "visual" , ":" , Visual ] ,
      [ "chrome" , ":" , ( boolean | object-any ) ] ,
      { extra-member } ,
    "}" ;

SlotLayout =
    "{" ,
      "box_offset" , ":" , "[" , ( number | string ) , "," , ( number | string ) , "," , ( number | string ) , "," , ( number | string ) , "]" ,
      [ "style" , ":" , ( string | TextStyle ) ] ,
      { extra-member } ,
    "}" ;

StrokeStyle =
    "{" ,
      [ "color" , ":" , string ] ,
      [ "width" , ":" , number ] ,
      [ "dash" , ":" , "[" , [ number , { "," , number } ] , "]" ] ,
      [ "arrow_start" , ":" , boolean ] ,
      [ "arrow_end" , ":" , boolean ] ,
      [ "linecap" , ":" , string ] ,
      [ "linejoin" , ":" , string ] ,
      [ "opacity" , ":" , number ] ,
      [ "stroke_opacity" , ":" , number ] ,
      { extra-member } ,
    "}" ;

SymbolDef =
    "{" ,
      "box" , ":" , "[" , number , "," , number , "," , number , "," , number , "]" ,
      [ "slots" , ":" , "[" , [ string , { "," , string } ] , "]" ] ,
      [ "ports" , ":" , "{" , { string , ":" , "[" , number , "," , number , "]" } , "}" ] ,
      [ "objects" , ":" , "[" , [ object-any , { "," , object-any } ] , "]" ] ,
      { extra-member } ,
    "}" ;

TextContract =
    "{" ,
      [ "min_font_size" , ":" , number ] ,
      [ "overflow" , ":" , ( "visible" | "clip" | "shrink_to_fit" ) ] ,
      { extra-member } ,
    "}" ;

TextStyle =
    "{" ,
      [ "font" , ":" , string ] ,
      [ "size" , ":" , number ] ,
      [ "weight" , ":" , ( integer | string ) ] ,
      [ "color" , ":" , string ] ,
      [ "align" , ":" , ( "left" | "center" | "right" ) ] ,
      [ "v_align" , ":" , ( "top" | "middle" | "bottom" ) ] ,
      [ "line_height" , ":" , number ] ,
      [ "italic" , ":" , boolean ] ,
      [ "wrap" , ":" , boolean ] ,
      [ "overflow" , ":" , ( "visible" | "clip" ) ] ,
      { extra-member } ,
    "}" ;

Tokens =
    "{" ,
      [ "colors" , ":" , "{" , { string , ":" , string } , "}" ] ,
      [ "fonts" , ":" , "{" , { string , ":" , string } , "}" ] ,
      [ "text_styles" , ":" , "{" , { string , ":" , TextStyle } , "}" ] ,
      [ "stroke_styles" , ":" , "{" , { string , ":" , StrokeStyle } , "}" ] ,
      [ "fill_styles" , ":" , "{" , { string , ":" , object-any } , "}" ] ,
      [ "glyph_map" , ":" , "{" , { string , ":" , string } , "}" ] ,
      { extra-member } ,
    "}" ;

TypeDef =
    "{" ,
      [ "meaning" , ":" , string ] ,
      [ "directionality" , ":" , ( "directed" | "undirected" | "bidirectional" ) ] ,
      { extra-member } ,
    "}" ;

Visual =
    "{" ,
      [ "tokens" , ":" , Tokens ] ,
      [ "symbols" , ":" , "{" , { string , ":" , SymbolDef } , "}" ] ,
      [ "component_defs" , ":" , "{" , { string , ":" , ComponentDef } , "}" ] ,
      [ "layers" , ":" , "[" , [ Layer , { "," , Layer } ] , "]" ] ,
      { extra-member } ,
    "}" ;

(* ── Lexical scalar terminals (YAML scalars / JSON primitives) ── *)
string       = ? any YAML scalar interpreted as text ? ;
number       = ? any YAML number — integer or float ? ;
integer      = ? any YAML integer ? ;
boolean      = "true" | "false" ;
null         = "null" | "~" ;   (* in YAML, an absent/empty value is also null *)
any          = string | number | boolean | null | array-any | object-any ;
array-any    = "[" , [ any , { "," , any } ] , "]" ;
object-any   = "{" , [ member-any , { "," , member-any } ] , "}" ;
member-any   = string , ":" , any ;

(* A model declared `extra="allow"` accepts arbitrary additional keys. *)
extra-member = string , ":" , any ;
